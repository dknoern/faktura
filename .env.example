AUTH_SECRET=
AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=
AUTH_AUTH0_ISSUER=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Sign-up flow: creates Auth0 users via the Management API using the same
# AUTH_AUTH0_ID/AUTH_AUTH0_SECRET application above. That application must be
# authorized for the Auth0 Management API (Dashboard -> Applications -> APIs ->
# Auth0 Management API -> Machine to Machine Applications) with scopes:
# create:users, update:users, read:users, create:user_tickets, delete:users
# (delete:users is used to roll back the Auth0 user if sign-up fails partway
# through, e.g. the Mongo write fails after the Auth0 user was created)
AUTH0_CONNECTION=Username-Password-Authentication
# Must be an SES-verified sender address; used as the From address for
# sign-up verification emails (a new tenant has no email domain of its own yet).
SIGNUP_EMAIL_FROM=

MONGODB_URI=mongodb://localhost:27017/faktura
IMAGE_BUCKET=
UPLOADS_DIR=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_REPAIR_LIST_ID=

# Encryption key for tenant secrets stored at rest (AES-256-GCM):
# Stripe restricted keys, AvaTax license keys, etc.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must base64-decode to exactly 32 bytes. Losing this value makes every stored
# tenant secret unrecoverable; admins would need to re-enter them.
CREDENTIALS_ENCRYPTION_KEY=